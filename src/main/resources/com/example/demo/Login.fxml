<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.LoginController">
    <left>
        <AnchorPane prefHeight="407.0" prefWidth="228.0" BorderPane.alignment="CENTER">
            <children>
                <ImageView fx:id="brandingImageView" fitHeight="400.0" fitWidth="228.0" layoutX="2.0" layoutY="-2.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@images/Register.jpg" />
                    </image>
                </ImageView>
            </children>
        </AnchorPane>
    </left>
    <right>
        <AnchorPane prefHeight="400.0" prefWidth="360.0" style="-fx-background-color: #ECECE7;" BorderPane.alignment="CENTER">
            <children>
                <ImageView fitHeight="32.0" fitWidth="46.0" layoutX="146.0" layoutY="50.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../images/lock_icon.png" />
                    </image>
                </ImageView>
                <Label layoutX="45.0" layoutY="129.0" text="Email">
                    <font>
                        <Font size="13.0" />
                    </font>
                </Label>
                <TextField fx:id="emailField" layoutX="108.0" layoutY="126.0" minHeight="26.0" prefWidth="173.0" promptText="Email" />
                <Label layoutX="45.0" layoutY="176.0" text="Password">
                    <font>
                        <Font size="13.0" />
                    </font>
                </Label>
                <PasswordField fx:id="passwordField" layoutX="108.0" layoutY="174.0" prefHeight="26.0" prefWidth="173.0" promptText="Password" />
                <Button fx:id="loginButton" layoutX="42.0" layoutY="233.0" mnemonicParsing="false" onAction="#loginButtonAction" prefHeight="32.0" prefWidth="240.0" style="-fx-background-color: #E96151;" text="Login" textFill="WHITE">
                    <font>
                        <Font size="13.0" />
                    </font>
                </Button>
                <Button fx:id="cancelButton" layoutX="42.0" layoutY="282.0" mnemonicParsing="false" onAction="#cancelButtonAction" prefHeight="32.0" prefWidth="240.0" style="-fx-background-color: #E96151;" text="Cancel" textFill="WHITE">
                    <font>
                        <Font size="13.0" />
                    </font>
                </Button>
                <Label fx:id="loginMessageLabel" alignment="CENTER" contentDisplay="CENTER" layoutX="9.0" layoutY="206.0" prefHeight="19.0" prefWidth="318.0" text="Invalid Login. Please try again." textFill="RED">
                    <font>
                        <Font size="13.0" />
                    </font>
                </Label>
                <!-- Lien vers la page d'inscription -->
                <Hyperlink layoutX="142.0" layoutY="320.0" text="Don't have an account? Register here" onAction="#goToRegisterPage"/>
            </children>
        </AnchorPane>
    </right>
</BorderPane>

