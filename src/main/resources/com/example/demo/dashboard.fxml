<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="500.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.Dashboard">

    <!-- Partie gauche : Menu -->
    <left>
        <VBox prefWidth="250" spacing="20" style="-fx-background-color: #2c3e50;">
            <Label prefHeight="27.0" prefWidth="103.0" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" text="Menu" />
            <Button fx:id="ajouterCollectionButton" style="-fx-pref-width: 200; -fx-background-color: #34495e; -fx-text-fill: white;" text="Ajouter une Collection" />
            <Button fx:id="consulterCollectionButton" style="-fx-pref-width: 200; -fx-background-color: #34495e; -fx-text-fill: white;" text="Consulter les Collections" />
            <Button fx:id="ajouterObjetButton" style="-fx-pref-width: 200; -fx-background-color: #34495e; -fx-text-fill: white;" text="Ajouter un Objet" />
            <Button fx:id="consulterObjetButton" prefHeight="26.0" prefWidth="213.0" style="-fx-pref-width: 200; -fx-background-color: #34495e; -fx-text-fill: white;" text="Consulter les Objets" />
            <Button fx:id="logoutButton" style="-fx-pref-width: 200; -fx-background-color: #e74c3c; -fx-text-fill: white;" text="Se Déconnecter" />
        </VBox>
    </left>

    <!-- Partie droite : Infos utilisateur -->
    <center>
        <VBox spacing="20" style="-fx-padding: 30;">
            <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Bienvenue !" />
            <Label fx:id="userNameLabel" style="-fx-font-size: 18px;" text="Nom : -" />
            <Label fx:id="userEmailLabel" style="-fx-font-size: 18px;" text="Email : -" />
            <Label fx:id="loginDateLabel" style="-fx-font-size: 18px;" text="Connecté depuis : -" />
        </VBox>
    </center>

</BorderPane>
